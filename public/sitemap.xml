<?xml version="1.0" encoding="UTF-8"?>
<!--
  As quatro páginas públicas do Kapa: a institucional e os três documentos que a LGPD manda deixar
  legíveis antes do cadastro. Nenhuma rota do app entra aqui — todas exigem sessão.

  As URLs são relativas porque o domínio só existe no go-live (P1 da Sprint 16). Ao publicar,
  troque por absolutas: o protocolo de sitemap pede a URL completa, e um caminho relativo é
  ignorado por parte dos robôs.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
