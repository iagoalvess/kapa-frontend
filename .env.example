# Copie para .env.local antes de rodar. O .env.local é ignorado pelo git.
#
# ATENÇÃO: tudo que começa com VITE_ é embutido no bundle e fica visível para
# qualquer usuário. Nenhum segredo entra aqui — segredo é assunto do backend.

# Endereço da API. Sem barra no final.
VITE_API_URL=http://localhost:8080

# O sistema e a página institucional (Sprint 33) — cada build manda para a outra por aqui.
# Em produção: https://app.kapaformaturas.com.br e https://kapaformaturas.com.br.
VITE_APP_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5180

# Só na build do site (Sprint 36): "true" troca "Entrar" e "Criar conta" pela lista de espera e
# esconde os preços e os documentos legais. Com ela ligada, a chave pública do Turnstile é obrigatória;
# a de teste abaixo passa sempre (docs da Cloudflare) e serve para o dev.
# VITE_LISTA_DE_ESPERA=true
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Nome exibido no cabeçalho e no título.
VITE_APP_NOME=Frontend
